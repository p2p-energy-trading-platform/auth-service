NODE_ENV=development

HTTP_HOST=0.0.0.0
HTTP_PORT=3000

GRPC_HOST=0.0.0.0
GRPC_PORT=50051

DATABASE_URL=postgres://auth_service_user:auth_service_password@localhost:5432/gridx_db?sslmode=disable
DOCKER_POSTGRES_URL=postgres://auth_service_user:auth_service_password@postgres:5432/gridx_db?sslmode=disable
REDIS_URL=redis://localhost:6379

AUTH_ISSUER=http://auth-service:3000
AUTH_AUDIENCE=gridx-api

AUTH_KEY_ID=auth-dev-001

AUTH_PRIVATE_KEY_PATH=./secrets/auth-private.pem
AUTH_PUBLIC_KEY_PATH=./secrets/auth-public.pem

AUTH_ACCESS_TOKEN_TTL_SECONDS=900

LOG_LEVEL=info

GRPC_TLS_ENABLED=false
GRPC_TLS_REQUIRE_CLIENT_CERT=false

# Required only when GRPC_TLS_ENABLED=true

# GRPC_TLS_CA_PATH=/run/secrets/ca.pem
# GRPC_TLS_CERT_PATH=/run/secrets/auth-server-cert.pem
# GRPC_TLS_KEY_PATH=/run/secrets/auth-server-key.pem