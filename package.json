{
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -D correctness -D suspicious --vitest-plugin --deny-warnings src test",
    "lint:fix": "oxlint -D correctness -D suspicious --vitest-plugin --fix src test",
    "format": "oxfmt --write src test",
    "format:check": "oxfmt --check src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check-config": "tsx scripts/check-config.ts",
    "db:create": "goose -dir migrations create",
    "db:up": "dotenv -- sh -c 'goose -dir migrations postgres \"$DATABASE_URL\" up'",
    "db:down": "dotenv -- sh -c 'goose -dir migrations postgres \"$DATABASE_URL\" down'",
    "db:status": "dotenv -- sh -c 'goose -dir migrations postgres \"$DATABASE_URL\" status'",
    "db:reset": "dotenv -- sh -c 'goose -dir migrations postgres \"$DATABASE_URL\" reset'",
    "keys:generate": "node scripts/generate-dev-keys.mjs",
    "predev": "npm run keys:generate",
    "pretest": "npm run keys:generate"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@p2p-energy-trading-platform/typescript-sdk": "github:p2p-energy-trading-platform/typescript-sdk#v1.1.1",
    "@prometheus-io/client": "^0.16.1",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "redis": "^6.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "dotenv-cli": "^11.0.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
